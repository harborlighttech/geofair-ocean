---
layout: null
permalink: /resources.jsonld
---
{%- assign indexed = site.resources | where_exp: "r", "site.catalogue.indexed_statuses contains r.status" | sort: "title" -%}
{
  "@context": {"@vocab": "https://schema.org/", "dct": "http://purl.org/dc/terms/", "broadMatch": "http://www.w3.org/2004/02/skos/core#broadMatch"},
  "@type": "ItemList",
  "@id": {{ site.url | append: site.baseurl | append: "/resources/" | jsonify }},
  "name": {{ site.title | append: " — resource catalogue" | jsonify }},
  "numberOfItems": {{ indexed | size }},
  "itemListOrder": "https://schema.org/ItemListUnordered",
  "itemListElement": [
    {%- for r in indexed %}
    {"@type": "ListItem", "position": {{ forloop.index }}, "item": {% include jsonld/resource.html resource=r %}}{% unless forloop.last %},{% endunless %}
    {%- endfor %}
  ]
}
