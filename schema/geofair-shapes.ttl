@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix schema: <https://schema.org/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix gf:     <https://example.github.io/geofair-ocean/shapes#> .

# SHACL shapes for the JSON-LD emitted by the GeoFAIR Resource Hub.
# Run: python scripts/validate_jsonld.py --shacl   (needs pyshacl, rdflib)

gf:LearningResourceShape
    a sh:NodeShape ;
    sh:targetClass schema:LearningResource ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:minCount 1 ; sh:maxCount 1 ; sh:maxLength 2000 ] ;
    sh:property [ sh:path schema:url ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:learningResourceType ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:DefinedTerm ] ;
    sh:property [ sh:path schema:license ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:dateModified ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^\\d{4}-\\d{2}-\\d{2}$" ] ;
    sh:property [ sh:path schema:inLanguage ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:about ; sh:minCount 2 ; sh:class schema:DefinedTerm ] ;
    sh:property [ sh:path schema:creativeWorkStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:DefinedTerm ] ;
    sh:property [ sh:path schema:isAccessibleForFree ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
    sh:property [ sh:path schema:review ; sh:class schema:Review ] ;
    sh:property [ sh:path dct:conformsTo ; sh:minCount 1 ] .

gf:DefinedTermShape
    a sh:NodeShape ;
    sh:targetClass schema:DefinedTerm ;
    sh:property [ sh:path schema:termCode ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:name ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:inDefinedTermSet ; sh:minCount 1 ; sh:maxCount 1 ] .

gf:ReviewShape
    a sh:NodeShape ;
    sh:targetClass schema:Review ;
    sh:property [ sh:path schema:reviewBody ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path schema:author ; sh:minCount 1 ; sh:maxCount 1 ] .
