{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.github.io/geofair-ocean/schema/resource.schema.json",
  "title": "GeoFAIR resource front matter",
  "description": "Front matter of a file in _resources/. Application profile of the RDA Minimal Metadata for Learning Resources (DOI 10.15497/RDA00073) plus GeoFAIR facets. Vocabulary ids are checked against _data/vocab/*.yml by scripts/validate_resources.py, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["local_id", "title", "description", "resource_url", "resource_type", "license", "version_date", "lifecycle_stages", "research_areas", "status"],
  "properties": {
    "layout": {"type": "string"},
    "local_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$", "$comment": "Author-assigned local identifier: letters, digits, dot, dash, underscore. Unique across _resources/ (case-insensitively). The file must be named <local_id>.md or <local_id>-<slug>.md, which makes it the resource's URL"},
    "title": {"type": "string", "minLength": 3, "maxLength": 1000, "$comment": "RDA 1 Title"},
    "description": {"type": "string", "minLength": 40, "maxLength": 2000, "$comment": "RDA 2 Abstract/Description"},
    "resource_url": {"type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 1000, "$comment": "RDA 8 URL to Resource"},
    "url_type": {"type": "string", "enum": ["URL", "DOI", "Handle", "ARK", "PURL", "URN"], "$comment": "RDA 9 Resource URL Type; subset of DataCite relatedIdentifierType"},
    "identifier": {"type": "string", "format": "uri", "pattern": "^https?://", "$comment": "Resolvable persistent identifier of the described resource, when resource_url is a plain landing page"},
    "resource_type": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "$comment": "RDA 11 Learning Resource Type; id from _data/vocab/resource_type.yml"},
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 2, "$comment": "SPDX identifier listed in _data/licenses.yml"},
        "name": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "$comment": "RDA 6 License"
    },
    "version_date": {"$ref": "#/$defs/date", "$comment": "RDA 7 Version Date"},
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["Person", "Organization"]},
          "orcid": {"type": "string", "pattern": "^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$"},
          "ror": {"type": "string", "pattern": "^https://ror\\.org/0[a-z0-9]{8}$"},
          "affiliation": {"type": "string"}
        }
      },
      "$comment": "RDA 3 Author(s)"
    },
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "$comment": "RDA 4 Primary Language, BCP 47"},
    "keywords": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 100}, "$comment": "RDA 5 Keyword(s)"},
    "audience": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "$comment": "RDA 10 Target Group; ids from _data/vocab/audience.yml"},
    "learning_outcomes": {"type": "array", "items": {"type": "string", "minLength": 5, "maxLength": 1000}, "$comment": "RDA 12 Learning Outcome(s)"},
    "access_cost": {"type": "string", "enum": ["no", "yes", "maybe"], "$comment": "RDA 13 Access Cost. Quote the value in YAML: \"no\" (unquoted no is parsed as false)"},
    "expertise_level": {"type": "string", "enum": ["beginner", "intermediate", "advanced"], "$comment": "RDA 14 Expertise Level"},
    "lifecycle_stages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "$comment": "GeoFAIR facet; ids from _data/vocab/lifecycle_stage.yml"},
    "research_areas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "$comment": "GeoFAIR facet; ids from _data/vocab/research_area.yml"},
    "object_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}, "$comment": "Digital object type(s); ids from _data/vocab/object_type.yml (DataCite resourceTypeGeneral). Derived from resource_type when omitted"},
    "status": {"type": "string", "enum": ["draft", "in-review", "published", "obsolete"], "$comment": "GeoFAIR facet; ids from _data/vocab/status.yml"},
    "superseded_by": {"type": "string", "minLength": 1, "$comment": "local_id of another resource, or an absolute URL; meaningful when status is obsolete"},
    "testimonials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "text"],
        "properties": {
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "type": {"type": "string", "enum": ["Person", "Organization"]},
              "affiliation": {"type": "string"},
              "url": {"type": "string", "format": "uri"}
            }
          },
          "text": {"type": "string", "minLength": 10, "maxLength": 1000},
          "date": {"$ref": "#/$defs/date"}
        }
      }
    },
    "image": {"type": "string"},
    "date_added": {"$ref": "#/$defs/date"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "obsolete"}}, "required": ["status"]},
      "then": {"$comment": "superseded_by is recommended for obsolete entries but not required"}
    }
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "$comment": "ISO 8601 calendar date. The validator normalises YAML date objects to this form before checking."
    }
  }
}
